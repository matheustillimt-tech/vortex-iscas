# ============================================================
# Vórtex Iscas — suas configurações (variáveis de ambiente)
# ============================================================
# Como usar: copie este arquivo com o nome .env.local (comando: cp .env.example .env.local)
# e preencha cada linha. O .env.local fica SÓ no seu computador e nunca vai pro GitHub.
# Na Vercel, você cadastra as mesmas linhas em Settings → Environment Variables
# (menos a SUPABASE_DB_PASSWORD).
#
# Depois de mudar qualquer coisa aqui, pare o `npm run dev` (Ctrl+C) e rode de novo.
# Na Vercel, a mudança só vale depois de publicar de novo (Redeploy).

# ------------------------------------------------------------
# 1. QUEM É VOCÊ (aparece no topo de todas as páginas)
# ------------------------------------------------------------
# Seu nome, do jeito que aparece no seu perfil
NEXT_PUBLIC_AUTHOR_NAME=Seu Nome
# Seu @ do Instagram (com ou sem o @)
NEXT_PUBLIC_AUTHOR_HANDLE=@seuperfil
# Selo azul de verificado ao lado do nome: true (mostra) ou false (esconde)
NEXT_PUBLIC_VERIFIED=false
# A foto de perfil NÃO fica aqui: troque o arquivo public/avatar.jpg pela sua foto
# (quadrada, com o mesmo nome avatar.jpg).

# ------------------------------------------------------------
# 2. BANCO DE DADOS (Supabase): onde os contatos ficam guardados
# ------------------------------------------------------------
# Onde pegar: supabase.com → seu projeto → Project Settings → API Keys (e Data API, pra URL).
# Ou pela linha de comando: supabase projects api-keys --project-ref SEU-PROJETO
# Endereço do projeto (troque SEU-PROJETO pelo "Reference ID" do seu projeto)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (ou "publishable"). Pode aparecer no navegador: ela só consegue GRAVAR lead, nunca ler.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# Chave "service_role" (ou "secret"). SECRETA: usada só pelo servidor, pro seu CRM de leads (/admin).
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
# Senha do banco: só pra linha de comando do Supabase (supabase link / db push). O site não usa.
# NÃO cadastre esta na Vercel.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------
# 3. SEU CRM DE LEADS (/admin)
# ------------------------------------------------------------
# Senha pra entrar no painel em seusite.com/admin. Use uma senha forte (12+ caracteres).
# Vazia = o painel fica trancado. Trocar a senha desconecta todo mundo que estava logado.
ADMIN_SENHA=

# ------------------------------------------------------------
# 4. CONVITE NO FIM DO MATERIAL (opcional)
# ------------------------------------------------------------
# Um bloco verde no material (e no fim do PDF) chamando pro próximo passo: uma aula, um grupo, uma consultoria.
# Deixe NEXT_PUBLIC_CONVITE_URL vazio e o bloco não aparece.
# Link do convite (grupo de WhatsApp, página da aula, agenda, formulário...)
NEXT_PUBLIC_CONVITE_URL=
# Etiqueta pequena em cima do título (ex: Aula gratuita e ao vivo)
NEXT_PUBLIC_CONVITE_SELO=Aula gratuita e ao vivo
# Título do convite
NEXT_PUBLIC_CONVITE_TITULO=Vou fazer uma aula ao vivo mostrando isso na prática.
# Uma frase explicando o que fazer
NEXT_PUBLIC_CONVITE_TEXTO=Entra no grupo pra receber o link da aula.
# Texto do botão
NEXT_PUBLIC_CONVITE_BOTAO=Entrar no grupo

# ------------------------------------------------------------
# 5. LGPD: e-mail de contato (aparece na política de privacidade, /privacidade)
# ------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com

# ------------------------------------------------------------
# 6. META PIXEL (opcional): pra medir anúncios e anunciar de novo pra quem visitou
# ------------------------------------------------------------
# Onde pegar: business.facebook.com → Gerenciador de Eventos → Fontes de dados → o número do pixel
NEXT_PUBLIC_META_PIXEL_ID=
